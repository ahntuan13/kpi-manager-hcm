rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin duy nhất. Phải trùng ADMIN_EMAIL trong config/firebase-config.js.
    function adminEmail()    { return 'ahntuan13@gmail.com'; }

    function signedIn()      { return request.auth != null; }
    function profilePath()   { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile()    { return signedIn() && exists(profilePath()); }
    function me()            { return get(profilePath()).data; }
    function active()        { return hasProfile() && me().active != false && me().role in ['admin', 'member', 'staff']; }
    function isAdmin()       { return active() && me().role == 'admin'; }
    function isManager()     { return active() && (me().role == 'admin' || me().role == 'member'); }   // Admin + Quản lý
    function isStaff()       { return active() && me().role == 'staff' && me().empId is string && me().empId != ''; }
    function initialized()   { return exists(/databases/$(database)/documents/meta/init); }

    // Dấu phiên bản Rules (v4). App đọc thử đường dẫn này sau khi đăng nhập: đọc được nghĩa là Rules trên Firebase
    // đúng là bản này; bị từ chối nghĩa là Firebase đang chạy bản Rules cũ và app sẽ hiện cảnh báo cho Admin.
    // Mỗi lần sửa Rules: đổi 'v4' ở đây và RULES_VER trong js/50-firebase-sync.js thành số mới.
    match /rulesCheck/{v} { allow get: if signedIn() && v == 'v4'; }

    // Hồ sơ người dùng (vai trò, nhân viên được gắn): mỗi người đọc hồ sơ của mình, Admin đọc / ghi tất cả.
    // Admin chỉ tạo được Quản lý và Nhân viên; vai trò admin chỉ dành cho adminEmail() ở lần thiết lập đầu tiên.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if (isAdmin() && request.resource.data.role in ['member', 'staff'])
        || (signedIn() && request.auth.uid == uid && !initialized()
            && request.resource.data.role == 'admin' && request.auth.token.email == adminEmail());
      allow update: if isAdmin() && (
           (uid != request.auth.uid && request.resource.data.role in ['member', 'staff'])
        || (uid == request.auth.uid && request.resource.data.role == 'admin' && request.resource.data.active == true));
      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    match /meta/{doc} {
      allow read: if signedIn();
      allow create: if signedIn() && doc == 'init' && !initialized() && request.auth.token.email == adminEmail();
    }

    // Settings (tên đơn vị, nhóm, ngày lễ): mọi người đang hoạt động đọc được để tính điểm, chỉ Admin sửa.
    match /config/company { allow read: if active(); allow write: if isAdmin(); }
    match /config/seq     { allow read: if active(); allow write: if isManager(); }
    // Danh bạ trong phòng (chỉ tên, mã NV, nhóm) để nhân viên chọn người làm chung. Admin cập nhật tự động.
    match /config/directory { allow read: if active(); allow write: if isAdmin(); }

    // Sao lưu đám mây: Admin + Quản lý được TẠO bản sao lưu; chỉ Admin xem / khôi phục / xoá.
    // Không ai sửa được bản sao lưu đã tạo (không có quyền update).
    match /config/backup { allow read, write: if isManager(); }
    match /backups/{id} {
      allow read, delete: if isAdmin();
      allow create: if isManager();
      match /parts/{n} {
        allow read, delete: if isAdmin();
        allow create: if isManager();
      }
    }

    // Nhân viên: Admin + Quản lý đọc tất cả; Nhân viên chỉ đọc hồ sơ của chính mình. Chỉ Admin thêm / sửa / xoá.
    match /employees/{id} {
      allow read:  if isManager() || (isStaff() && id == me().empId);
      allow write: if isAdmin();
    }

    // Bảng KPI (mỗi nhân viên × mỗi năm là 1 document, có trường empId):
    //  - Admin + Quản lý đọc / ghi tất cả.
    //  - Nhân viên CHỈ đọc và ghi bảng của chính mình; không đổi được empId, không xoá được.
    match /sheets/{id} {
      allow read:   if isManager() || (isStaff() && resource.data.empId == me().empId);
      allow create: if isManager() || (isStaff() && request.resource.data.empId == me().empId);
      allow update: if isManager()
        || (isStaff() && resource.data.empId == me().empId && request.resource.data.empId == me().empId);
      allow delete: if isAdmin();
    }

    // Việc làm chung (mỗi nhóm có members = người đang làm, invited = người được mời):
    //  - Admin + Quản lý đọc / ghi tất cả.
    //  - Nhân viên đọc / sửa nhóm mình đang làm hoặc được mời (nhận / từ chối lời mời, ghi ngày hoàn thành chung);
    //    tạo nhóm mới phải có chính mình trong members. Chỉ quản lý xoá được nhóm.
    match /groups/{gid} {
      allow read:   if isManager() || (isStaff() && (me().empId in resource.data.members || me().empId in resource.data.invited));
      allow create: if isManager() || (isStaff() && me().empId in request.resource.data.members);
      allow update: if isManager() || (isStaff() && (me().empId in resource.data.members || me().empId in resource.data.invited));
      allow delete: if isManager();
    }
  }
}
